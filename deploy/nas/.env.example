# Copy to deploy/nas/.env on the NAS. Never commit the real file.
PERSONA_IMAGE=persona-nas:local
PERSONA_DATA_DIR=/volume1/docker/persona/data
PERSONA_BACKUP_DIR=/volume1/docker/persona/backups
PERSONA_BACKUP_RETENTION_DAYS=30

# Existing iKuai Tunnel mode: point Cloudflare at this VM's fixed LAN IP.
# Set this to the PVE VM address; bind to the VM IP instead of 0.0.0.0 when possible.
PERSONA_GATEWAY_BIND_IP=
PERSONA_GATEWAY_PORT=8080

# Exact public Workspace origin protected by Cloudflare Access.
# Leave the token empty when the existing iKuai Tunnel owns the route.
PERSONA_ALLOWED_ORIGINS=https://persona.changwt.cc
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# Production model configuration. Do not use mock for the NAS runtime.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
OPENAI_API_KEY=sk-your_deepseek_key_here
PERSONA_ANALYSIS_ENDPOINT=
PERSONA_ANALYSIS_MODEL=
PERSONA_ANALYSIS_API_KEY=
PERSONA_TIME_ZONE=Asia/Shanghai
PERSONA_DAILY_SUMMARY_ENABLED=true
PERSONA_OBSIDIAN_SNAPSHOT_ENABLED=false

# Optional Telegram integration.
TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
