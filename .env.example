# Optional. Leave empty to disable Telegram in local real-mode runs.
TELEGRAM_TOKEN=
# Required when TELEGRAM_TOKEN is set. Comma-separated trusted numeric chat IDs.
TELEGRAM_ALLOWED_CHAT_IDS=

# Required when LLM_PROVIDER=deepseek.
# Current DeepSeek adapter reads this variable as the bearer token for
# https://api.deepseek.com/v1/chat/completions.
OPENAI_API_KEY=sk-your_deepseek_key_here

# Use "mock" for no-network smoke tests.
# Use "deepseek" for the real local Persona runtime.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
API_PORT=3001
# Loopback is the safe default. Use a non-loopback host only behind authentication.
API_HOST=127.0.0.1
# Public blog URL used by the Workspace sidebar. Use the local port in development
# and the deployed blog domain in production.
NEXT_PUBLIC_BLOG_BASE_URL=http://127.0.0.1:5175
# Comma-separated browser origins allowed to call the local Persona API.
PERSONA_ALLOWED_ORIGINS=http://127.0.0.1:5173
# IANA time zone used to decide which Events belong to a Daily Note.
PERSONA_TIME_ZONE=Asia/Shanghai

# External Obsidian vault read by Workspace sync and VitePress.
# The vault stays outside the repository.
OBSIDIAN_VAULT_PATH=C:\Users\33831\OneDrive\obsidian\obsidian
# Relative directory inside the vault used for Persona-managed Daily Notes.
PERSONA_DAILY_NOTE_DIR=persona/daily-notes

# SQLite is the current implementation.
# Runtime data is stored at data/persona-os.db from the repository root.
